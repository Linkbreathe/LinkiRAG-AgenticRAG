# Linki configuration — copy to linki.yaml and edit. All fields are optional;
# omitted fields fall back to the defaults in src/linki/config.py.
#
# Model provider and API keys live in .env (never here):
#   OPENAI_API_KEY=sk-...        (or DEEPSEEK_API_KEY=...)
#   LINKI_PROVIDER=openai        (openai | deepseek | gateway)
#   LINKI_MODEL=gpt-4o-mini
#   LINKI_JUDGE_MODEL=gpt-4o-mini   # verifier/grader; use a different model than LINKI_MODEL
# Gateway adapter (LiteLLM-compatible; optional):
#   LINKI_GATEWAY_BASE_URL=http://localhost:4000/v1
#   LINKI_GATEWAY_API_KEY=...

# —— retrieval & agentic loops ——
retrieval_k: 5
candidate_k: 30      # high-recall child candidates before reranking
rerank_k: 8          # parents/spans retained after local cross-encoder
enable_local_reranker: true
reranker_model: Xenova/ms-marco-MiniLM-L-6-v2
supporting_span_chars: 1600
evidence_budget_fast: 1200
evidence_budget_balanced: 2400
evidence_budget_deep: 4000
graph_retrieval: none  # none | ppr_pilot (requires an injected graph adapter)
max_rounds: 2        # grader -> refine loop cap (per sub-query)
max_attempts: 2      # verifier -> reflow cap (whole answer)

# —— adaptive runtime / versioned cache ——
adaptive_enabled: true
execution_mode: auto  # auto | fast | balanced | deep
max_concurrency: 16
enable_persistent_cache: true
enable_answer_cache: true
enable_semantic_cache: false  # only enable after project-specific false-hit calibration
answer_cache_ttl_seconds: 86400
retrieval_cache_ttl_seconds: 604800
enable_memory: true
memory_background_formation: true
memory_token_budget: 300
episodic_retention_days: 90
# Source/Claim ledger, Wiki metadata, and temporal graph projection:
# knowledge_path: .linki/knowledge/ledger.sqlite3
# qdrant_url: http://localhost:6333  # optional server profile; embedded is default
# qdrant_api_key_env: QDRANT_API_KEY
# qdrant_prefer_grpc: true

# —— chunking ——
child_chunk_size: 500
child_chunk_overlap: 100
min_parent_size: 2000
max_parent_size: 4000

# —— embeddings (local, no API) ——
dense_model: BAAI/bge-small-en-v1.5   # via fastembed (ONNX, no torch)
sparse_model: Qdrant/bm25

# —— knowledge bases ——
# The `usage_hint` is the ONLY routing signal the planner sees (Phase 3): write it
# as "what this KB holds / which questions belong here".
knowledge_bases:
  - name: default
    title: Default knowledge base
    usage_hint: General ingested documents. Query here for anything not covered by a more specific base.
  # - name: api
  #   title: Framework API docs
  #   usage_hint: FastAPI/Flask official docs. Come here for API usage, config params, deployment.
  # - name: meetings
  #   title: Meeting notes
  #   usage_hint: Team meeting minutes. Come here for decisions, action items, discussions.
